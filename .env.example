# Copy this file to .env and replace every CHANGE_ME value before deployment.

# PostgreSQL
POSTGRES_DB=freecord
POSTGRES_USER=freecord
POSTGRES_PASSWORD=change-me-url-safe-database-password
DATABASE_URL=postgresql://freecord:change-me-url-safe-database-password@postgres:5432/freecord
DATABASE_SSL=false

# First-start owner bootstrap. Both values may be removed after the first
# successful initialization; changing them later does not change the owner.
FREECORD_INITIAL_ADMIN_USERNAME=change-me-owner-username
FREECORD_INITIAL_ADMIN_PASSWORD=change-me-long-initial-owner-password
FREECORD_COMMUNITY_NAME=FreeCord
FREECORD_COMMUNITY_SLUG=freecord

# Authentication
SESSION_SECRET=change-me-unique-random-session-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Public and internal LiveKit addresses
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=change-me-random-livekit-api-key
LIVEKIT_API_SECRET=change-me-unique-random-livekit-secret-at-least-32-characters
LIVEKIT_TOKEN_TTL_SECONDS=60
LIVEKIT_SIGNALING_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_RANGE=50000-50010

# MinIO administration. Do not reuse these as the API storage account.
MINIO_ROOT_USER=change-me-private-minio-root-user
MINIO_ROOT_PASSWORD=change-me-unique-random-minio-root-password
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# Bucket-limited application storage credentials
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=freecord-media
S3_ACCESS_KEY=change-me-separate-freecord-storage-access-key
S3_SECRET_KEY=change-me-unique-random-storage-secret-at-least-32-characters
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=26214400

# Desktop-only deployments normally leave browser origins empty.
ALLOWED_ORIGINS=
GIPHY_API_KEY=
FREECORD_API_PORT=8081

# Optional desktop-process setting, not consumed by Docker Compose. Set this in
# the client process environment to enable the isolated Copyparty tab.
# FREECORD_FILES_ORIGIN=https://files.example.com
