# Required for a new FreeCord installation.
LIVEKIT_URL=wss://rtc.example.com
FREECORD_INITIAL_ADMIN_PASSWORD=change-me-owner-password-at-least-12-characters

# Common optional settings. Defaults are shown.
FREECORD_INITIAL_ADMIN_USERNAME=admin
FREECORD_COMMUNITY_NAME=FreeCord
FREECORD_COMMUNITY_SLUG=freecord
FREECORD_API_PORT=8081
GIPHY_API_KEY=

# See docs/CONFIGURATION.md for ports, storage, token lifetimes, image tags,
# CORS, and first-deployment overrides for automatically generated secrets.
