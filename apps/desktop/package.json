{
  "name": "freecord-desktop",
  "version": "0.8.0-alpha.1",
  "private": true,
  "author": "FreeCord",
  "description": "FreeCord secure desktop client",
  "desktopName": "FreeCord",
  "main": "dist-main/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist-main/main/main.js dist-main/preload/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build": "tsc -p tsconfig.main.json && vite build",
    "package:win": "npm run build && electron-builder --config ../../electron-builder.yml --win --publish never",
    "package:linux": "npm run build && electron-builder --config ../../electron-builder.yml --linux --publish never",
    "package:dir": "npm run build && electron-builder --config ../../electron-builder.yml --dir --publish never"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "livekit-client": "2.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.4"
  }
}
